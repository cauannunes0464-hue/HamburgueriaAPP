
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HamburgueriaAPP.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
        x:Class="HamburgueriaAPP.Views.MainWindow"
        x:DataType="vm:ClienteViewModel"

        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="35"

        Icon="/Assets/avalonia-logo.ico"
        Title="HamburgueriaAPP">

    <Design.DataContext>
        <vm:ClienteViewModel/>
    </Design.DataContext>

    <!-- GRID PRINCIPAL -->
    <Grid RowDefinitions="35,70,*"
          ColumnDefinitions="3*,1*">

        <!-- Barra de Controle -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="#000000">

            <DockPanel>

                <TextBlock
                    Text="Sistema Caixa"
                    Margin="12"
                    Foreground="White"
                    FontSize="12"
                    VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                    <Button Content="—" Width="40"/>
                    <Button Content="□" Width="40"/>
                    <Button Content="X" Width="40"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Barra Burguer House -->
        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#202020"
                BorderBrush="#4A4A52"
                BorderThickness="0,0,0,4">

            <TextBlock
                Text="Burguer House"
                Margin="12,6,0,0"
                Foreground="White"
                FontSize="40"
                VerticalAlignment="Center"/>

        </Border>

        <!-- AREA PRODUTOS -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Background="#1E1E1E">



            <Grid RowDefinitions="140,*">

                <!-- FILTRO -->
                <Border Grid.Row="0"
                        BorderBrush="#3A3A3A"
                        BorderThickness="0,0,0,1"
                        Padding="15">

                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="Filtro de Grupo Produtos"
                            Foreground="White"
                            FontSize="24"/>


                        <WrapPanel >

                            <Button
                                 Width="220"
                                 Height="75"
                                 Margin="0,0,22,0">

                                <StackPanel>

                                    <TextBlock 
                                        Text="Todos"
                                        FontSize="22"
                                        Margin="12,20,12,0"
                                        HorizontalAlignment="Center">
                                    </TextBlock>
									
                                </StackPanel>
                            
                            </Button>
                               
                                     

                            <Button
                                 Width="220"
                                 Height="75"
                                 Margin="0,0,22,0">

                                <StackPanel>

                                    <TextBlock 
                                        Text="Hambuerguer"
                                        FontSize="22"
                                        Margin="12,20,12,0"
                                        HorizontalAlignment="Center">
                                    </TextBlock>
									
                                </StackPanel>
                            
                            </Button>

                             <Button
                                 Width="220"
                                 Height="75"
                                 Margin="0,0,22,0">

                                <StackPanel>

                                    <TextBlock 
                                        Text="Bebidas"
                                        FontSize="22"
                                        Margin="12,20,12,0"
                                        HorizontalAlignment="Center">
                                    </TextBlock>
									
                                </StackPanel>
                            
                            </Button>


                             <Button
                                 Width="220"
                                 Height="75"
                                 Margin="0,0,12,0">

                                <StackPanel>

                                    <TextBlock 
                                        Text="Sobremesa"
                                        FontSize="22"
                                        Margin="12,20,12,0"
                                        HorizontalAlignment="Center">
                                    </TextBlock>
									
                                </StackPanel>
                            
                            </Button>


                        </WrapPanel>

                    </StackPanel>

                </Border>

                <!-- PRODUTOS -->
                <Border Grid.Row="1"
                        Padding="15">

                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="Escolha o Produto"
                            Foreground="White"
                            FontSize="24"/>

                        <UniformGrid Columns="4"
                                     Rows="3">

                            <Button Content="🍔"/>

                            <Button Content="🥤"/>

                            <Button Content="🥫"/>

                            <Button Content="🍺"/>

                            <Button Content="🍟"/>

                            <Button Content="🍰"/>

                            <Button Content="🥧"/>


                        </UniformGrid>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- AREA PEDIDO -->
        <Border Grid.Row="2"
                Grid.Column="1"
                Background="#2F2F2F"/>

    </Grid>

</Window>